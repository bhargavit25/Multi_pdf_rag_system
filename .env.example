# Server Port
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/multi_pdf_rag

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_multi_pdf_rag_2025_secure
JWT_EXPIRES_IN=7d

# LLM Provider Configuration ('gemini', 'openai', 'groq', 'local')
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Embeddings Provider Configuration ('gemini', 'openai', 'local')
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_or_openai_api_key_here
EMBEDDING_MODEL=text-embedding-004

# Vector DB Configuration
# VECTOR_STORE_PROVIDER can be 'chroma' or 'local' (or 'chroma-fallback')
VECTOR_STORE_PROVIDER=chroma-fallback
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=pdf_documents

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Document Processing & RAG Parameters
MAX_FILE_SIZE=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
